# When each universe last changed, for the list printed by `--universe <unknown>` (newest last).
# Run at every build: cmake -DSRC=<source dir> -DOUT=<generated file> -P universe_dates.cmake
# A universe's date is its last commit's; a universe with uncommitted changes (or not committed yet) takes the
# newest modification time of its files instead. Without git, the newest modification time.
find_package(Git QUIET)
file(GLOB dirs LIST_DIRECTORIES true ${SRC}/src/universes/*)
set(out "// Generated by tools/universe_dates.cmake: UNIVERSE_DATE(id, unix time of its last change).\n")
foreach(dir ${dirs})
  if(NOT IS_DIRECTORY ${dir})
    continue()
  endif()
  get_filename_component(id ${dir} NAME)
  set(date 0)
  set(dirty 1)
  if(GIT_FOUND)
    execute_process(COMMAND ${GIT_EXECUTABLE} log -1 --format=%ct -- src/universes/${id}
                    WORKING_DIRECTORY ${SRC} OUTPUT_VARIABLE date OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    execute_process(COMMAND ${GIT_EXECUTABLE} status --porcelain -- src/universes/${id}
                    WORKING_DIRECTORY ${SRC} OUTPUT_VARIABLE status ERROR_QUIET)
    if(date AND NOT status)
      set(dirty 0)
    endif()
  endif()
  if(dirty)
    file(GLOB_RECURSE files ${dir}/*)
    foreach(f ${files})
      file(TIMESTAMP ${f} t "%s")
      if(NOT date OR t GREATER date)
        set(date ${t})
      endif()
    endforeach()
  endif()
  if(NOT date)
    set(date 0)
  endif()
  string(APPEND out "UNIVERSE_DATE(${id}, ${date})\n")
endforeach()
file(WRITE ${OUT}.tmp "${out}")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different ${OUT}.tmp ${OUT})
