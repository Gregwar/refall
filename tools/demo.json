// The demo video, described for tools/demo.py (JSON with // comment lines).
//
// The whole song plays once, uncut: video time = song time. The chapters follow each other and fill their span
// with shots, cut on the song's beat grid ("grid": "bar" or "beat"), none shorter than `min_shot`. A chapter may
// open with a title card on black ("card": {"text", "bars": N or "len": "6beats", "enabled"}); a chapter or a card
// with "enabled": false is left out (the cards are kept here, off, to turn back on).
// Times are anchors on the game's analysis of the song (refall --analysis), never fixed seconds:
//   start | end | drop:N (the Nth drop) | section:KIND[:N] (INTRO BREAK VERSE BUILD CHORUS DROP OUTRO) | bar:N | 12.5s
//   then any offsets: "+ 2bars", "- 4beats", "+ 1.5s". A chapter's `end` is snapped to the nearest downbeat.
// Shots: {"u": "id[:VARIANT]", "len": "4bars" | "6beats" (fixed) or "weight": 2 (a share of what is left),
//         "start": anchor (pins where the shot begins), "fade_in": "1bar" (from black), "env": {...}, "seed": N}.
// "accelerate": R makes a chapter's first shots R times longer than its last ones (whole grid units).
// With "cover_all": true, a chapter with "fill": true also gets every enabled universe that no chapter names (in
// `fill_order`, then in registry order), so all of them appear and a new universe shows up without editing this file.
{
  "song": "ytdl:9Sh9ZSecyFU",
  "song_title": "callah x Laura Brehm - skyline",
  "size": "1920x1080",
  "fps": 30,
  "seed": 2026,
  "max_mb": 29.5,
  "min_shot": "1bar",
  // false: only the universes the chapters name (true: every enabled universe, the ones no chapter names added to
  // the "fill" chapter)
  "cover_all": false,
  // the play speeds up over the video, from the first shot to the last one: the autoplay's pace (x the clip's calm
  // pace) and the fall's velocity (the game's velocity, 1 .. 40; never 20G here). The pieces fall at the gravity's
  // own speed (the autoplay only turns and slides them), so the first shots' velocity keeps a few clears in them.
  "pace": [1.0, 2.6],
  "velocity": [6.6, 32],
  // one game across the whole video: the stack carries on across the cuts (every shot replays the same game from the
  // song's start, unseen until its warm-up; one seed, no seed search for clears)
  "continuous": true,
  // its seed: the one of this many whose game clears a line inside the most shots
  "seed_search": 12,
  // seconds of crossfade between two shots, centred on the cut
  "crossfade": 0.4,
  // every shot shows a line clear: game seeds are tried (up to `tries`, the best of the first `pick_of` that show one)
  // until a clear happens between `lead` s after the shot's start and `tail` s before its end; a shot's own "clear"
  // overrides it, "clear": null turns it off
  "clear": {"tries": 12, "pick_of": 3, "lead": 0.4, "tail": 0.8},

  // The environment of every shot (the game's test hooks): progression universes on their 50-line reference
  // scale, a short warm-up started on a played-in stack.
  "env": {"REFALL_SCENE_LINES": "50", "REFALL_WARMUP": "10", "REFALL_CLIP_FILL": "1"},
  // Per universe, wherever it appears (a shot's own env overrides it): a nice stage of the progression ones.
  "universe_env": {
    "gianttree": {"REFALL_GIANTTREE_LINES": "16"},
    "megacity": {"REFALL_MEGACITY_LINES": "14"},
    "orbital": {"REFALL_ORBITAL_LINES": "26"},
    "library": {"REFALL_LIBRARY_LINES": "30"},
    "planks": {"REFALL_PLANKS_LINES": "24"},
    "mycelium": {"REFALL_MYCELIUM_LINES": "16"},
    "tidepool": {"REFALL_TIDEPOOL_LINES": "16"},
    "lostpanda": {"REFALL_LOSTPANDA_LINES": "20"},
    "skywhale": {"REFALL_SKYWHALE_LINES": "31", "REFALL_GROW_RATE": "0.75"},
    "bricks": {"REFALL_WARMUP": "40"},
    "docks": {"REFALL_WARMUP": "40"},
    // (no played-in stack: BIOME's world would take it as grown already; the sea just starting over the dunes)
    "biome": {"REFALL_WARMUP": "8", "REFALL_CLIP_FILL": "0"},
    "brutalist": {"REFALL_WARMUP": "40"},
    "tiles": {"REFALL_WARMUP": "40"},
    "neon": {"REFALL_WARMUP": "40"}
  },

  "fonts": {
    "title": "src/embed/CormorantGaramond-Italic.ttf",
    "small": "src/embed/TenorSans-Regular.ttf"
  },

  "chapters": [
    // off: the video starts on the game
    {"id": "opening", "enabled": false, "end": "section:BREAK",
     "card": {"text": "Refall", "style": "title"}},

    // the intro and the verse: light in the dark and crafts, fading in from black
    {"id": "discover", "end": "drop:1 - 1bar",
     "card": {"text": "Discover many universes", "bars": 2, "enabled": false},
     "grid": "bar", "fill": true,
     "shots": [{"u": "lanterns", "fade_in": "1bar", "env": {"REFALL_CLIP_FILL": "0"},
                "clear": {"tries": 12, "pick_of": 3, "lead": 0.4, "tail": 0.8, "quad": false}}, {"u": "origami"}, {"u": "rainy"}, {"u": "sonar"},
               {"u": "microscope:PHASE"}]},

    // a bar before the first drop, a universe that reacts to it: the drop lands on it
    {"id": "listen", "end": "drop:1 + 2bars",
     "card": {"text": "Listen to your music", "len": "6beats", "enabled": false},
     "grid": "bar",
     "shots": [{"u": "bauhaus"}]},

    // the drop
    {"id": "drop", "end": "drop:1 + 26bars",
     "grid": "bar",
     "shots": [{"u": "manga"}, {"u": "forest"}, {"u": "neon"}, {"u": "laser"}, {"u": "limbo"}, {"u": "brutalist"}]},

    {"id": "build", "end": "drop:2",
     "card": {"text": "Build things", "bars": 2, "enabled": false},
     "grid": "bar",
     "shots": [{"u": "bricks"}, {"u": "rain"}, {"u": "gianttree:SUNSET"}, {"u": "megacity:TWILIGHT"},
               {"u": "biome"}]},

    // from the second drop: the 3D beauties, then the whale around the Moon to the end (its clear before the game
    // fades away for the outro)
    {"id": "enjoy", "end": "end",
     "card": {"text": "Enjoy the experience", "bars": 2, "enabled": false},
     "grid": "bar",
     "shots": [{"u": "tidepool"}, {"u": "docks"}, {"u": "skyocean"}, {"u": "crystal"},
               // the game and its HUD fade away at about 2:10, on the first piece landing from 13.7 s to 9.2 s before
               // the song's end (REFALL_OUT_LEAD + 2.5 .. - 2), so the clear must come before it; then the whale alone
               // under the logo
               {"u": "skywhale:MOONLIGHT", "start": "section:OUTRO - 4bars", "env": {"REFALL_OUT_LEAD": "11.2"},
                "clear": {"tries": 12, "pick_of": 3, "lead": 1.0, "tail": 13.8}}],
     // the end: the logo's white contours over the whale as soon as the game's HUD fades away ("at": "hud"), then
     // the logo in color as the scene fades to black
     "outro": {"fade": "2.5bars",
               "logo": {"at": "hud", "size": 0.66, "fade_in": 4.0}}}
  ]
}
