<?xml version="1.0" encoding="utf-8"?>
<!-- Refall as a NativeActivity: no Java code, the game is libmain.so (android/build.sh) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="org.gregwar.refall"
          android:versionCode="1"
          android:versionName="0.1">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="34" />
    <uses-feature android:glEsVersion="0x00030002" android:required="true" />
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="Refall" android:hasCode="false" android:icon="@mipmap/icon"
                 android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
        <activity android:name="android.app.NativeActivity"
                  android:exported="true"
                  android:screenOrientation="sensorLandscape"
                  android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode"
                  android:resizeableActivity="false">
            <meta-data android:name="android.app.lib_name" android:value="main" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
